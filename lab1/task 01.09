word = "объектно-ориентированный"

w1 = word[0:6]  # (слово объект)
w2 = word[9:17] #(слово ориентир)
w3 = word[14:17] #(слово тир)
w4 = word[4]+ word[9]+ word[14] # (слово кот)
w5 = word[10] + word[3]+ word[6]+ word[5]+word[19]#(слово рента)

print(w1, w2, w3, w4, w5, sep="\n")
